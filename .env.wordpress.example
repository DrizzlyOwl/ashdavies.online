WORDPRESS_DB_HOST='mysql'
WORDPRESS_DB_USER='%%'
WORDPRESS_DB_PASSWORD='%%'
WORDPRESS_DB_NAME='%%'
WORDPRESS_DEBUG=true
WORDPRESS_CONFIG_EXTRA="
/* Custom rules */
define( 'WP_REDIS_HOST', '%%' );
define( 'WP_HOME', 'http://local.domain:8080' );
define( 'WP_SITEURL', 'http://local.domain:8080' );"
# Local development mail is captured by the Mailpit container (see
# docker-compose.yml). SMTP_INSECURE disables auth/TLS for the plain catcher.
# Web UI: http://localhost:8025
SMTP_HOSTNAME="mailhog"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="local@ashdavies.online"
SMTP_FROM_NAME="Ash Davies (local)"
SMTP_INSECURE=1